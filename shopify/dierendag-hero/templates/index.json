product-content {\n  padding: 24px;\n}\n\n.rr-product-content h3 {\n  margin: 0 0 12px;\n  color: var(--rr-text);\n  font-size: 22px;\n  line-height: 1.2;\n  font-weight: 900;\n}\n\n.rr-stars {\n  margin-bottom: 14px;\n  color: var(--rr-coral);\n  font-size: 16px;\n  letter-spacing: 1px;\n}\n\n.rr-stars small {\n  margin-left: 4px;\n  color: var(--rr-muted);\n  font-size: 13px;\n  letter-spacing: 0;\n}\n\n.rr-product-content ul {\n  display: grid;\n  gap: 9px;\n  margin: 0 0 18px;\n  padding: 0;\n  list-style: none;\n}\n\n.rr-product-content li {\n  position: relative;\n  padding-left: 26px;\n  color: var(--rr-muted);\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n.rr-product-content li::before {\n  content: \"✓\";\n  position: absolute;\n  left: 0;\n  top: 0;\n  color: var(--rr-blue);\n  font-weight: 900;\n}\n\n.rr-price {\n  display: flex;\n  align-items: baseline;\n  gap: 10px;\n  margin-bottom: 18px;\n}\n\n.rr-price del {\n  color: #9ca3af;\n  font-size: 14px;\n}\n\n.rr-price strong {\n  color: var(--rr-text);\n  font-size: 22px;\n  font-weight: 900;\n}\n\n.rr-product-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 48px;\n  padding: 13px 18px;\n  border-radius: 999px;\n  background: linear-gradient(135deg, var(--rr-coral), var(--rr-purple));\n  color: #ffffff !important;\n  text-decoration: none !important;\n  font-size: 14px;\n  font-weight: 900;\n}\n\n.rr-product-btn-disabled {\n  pointer-events: none;\n  cursor: not-allowed;\n  opacity: 0.55;\n  background: #a8adba;\n}\n\n/* ADVICE */\n.rr-advice-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 18px;\n}\n\n.rr-advice-card {\n  min-height: 260px;\n  padding: 26px 22px;\n  border-radius: 26px;\n  background: #ffffff;\n  border: 1px solid var(--rr-border);\n  box-shadow: var(--rr-shadow);\n  text-decoration: none !important;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.rr-advice-primary {\n  background: linear-gradient(135deg, #fff2ee 0%, #ffffff 100%);\n  border-color: #ffd4cc;\n}\n\n.rr-advice-water {\n  background: linear-gradient(135deg, #eef3ff 0%, #ffffff 100%);\n}\n\n.rr-advice-label {\n  width: fit-content;\n  margin-bottom: 16px;\n  padding: 8px 12px;\n  border-radius: 999px;\n  background: var(--rr-soft);\n  color: var(--rr-purple-dark);\n  font-size: 12px;\n  font-weight: 900;\n  text-transform: uppercase;\n  letter-spacing: 0.07em;\n}\n\n.rr-advice-card h3 {\n  margin: 0 0 12px;\n  color: var(--rr-text);\n  font-size: 24px;\n  line-height: 1.15;\n  font-weight: 900;\n  letter-spacing: -0.035em;\n}\n\n.rr-advice-card p {\n  margin: 0 0 18px;\n  color: var(--rr-muted);\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.rr-advice-card span {\n  color: var(--rr-coral-dark);\n  font-weight: 900;\n}\n\n/* BENEFITS */\n.rr-benefits {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n  margin-bottom: 72px;\n  padding: 22px;\n  border-radius: 28px;\n  background: linear-gradient(135deg, var(--rr-soft) 0%, #ffffff 100%);\n  border: 1px solid var(--rr-border);\n}\n\n.rr-benefit {\n  display: grid;\n  grid-template-columns: 48px 1fr;\n  grid-template-rows: auto auto;\n  column-gap: 12px;\n  align-items: center;\n  padding: 18px;\n  border-radius: 20px;\n  background: #ffffff;\n  border: 1px solid #f0edff;\n}\n\n.rr-benefit div {\n  grid-row: 1 / span 2;\n  width: 48px;\n  height: 48px;\n  border-radius: 16px;\n  background: var(--rr-soft);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n}\n\n.rr-benefit strong {\n  color: var(--rr-text);\n  font-size: 16px;\n  font-weight: 900;\n}\n\n.rr-benefit span {\n  color: var(--rr-muted);\n  font-size: 13px;\n}\n\n/* INFO */\n.rr-info-block {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) 430px;\n  gap: 28px;\n  align-items: stretch;\n  padding: 38px;\n  border-radius: 32px;\n  background: linear-gradient(135deg, #f7f2ff 0%, #ffffff 70%);\n  border: 1px solid var(--rr-border);\n  box-shadow: var(--rr-shadow);\n}\n\n.rr-info-buttons,\n.rr-final-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n  margin-top: 28px;\n}\n\n.rr-main-btn,\n.rr-light-btn,\n.rr-final-main,\n.rr-final-light {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 52px;\n  padding: 15px 24px;\n  border-radius: 999px;\n  font-size: 15px;\n  line-height: 1.2;\n  font-weight: 900;\n  text-decoration: none !important;\n}\n\n.rr-main-btn,\n.rr-final-main {\n  background: linear-gradient(135deg, var(--rr-coral), var(--rr-purple));\n  color: #ffffff !important;\n}\n\n.rr-light-btn {\n  background: #ffffff;\n  color: var(--rr-purple-dark) !important;\n  border: 1px solid var(--rr-border);\n}\n\n.rr-info-card {\n  padding: 26px;\n  border-radius: 26px;\n  background: #ffffff;\n  border: 1px solid var(--rr-border);\n}\n\n.rr-info-card h3 {\n  margin: 0 0 18px;\n  color: var(--rr-text);\n  font-size: 24px;\n  line-height: 1.2;\n  font-weight: 900;\n}\n\n.rr-info-card a {\n  display: block;\n  padding: 18px 0;\n  border-top: 1px solid #f1efff;\n  text-decoration: none !important;\n}\n\n.rr-info-card strong {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--rr-text);\n  font-size: 17px;\n  font-weight: 900;\n}\n\n.rr-info-card span {\n  color: var(--rr-muted);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n/* FINAL CTA */\n.rr-final-cta {\n  margin-top: 72px;\n  padding: 48px 28px;\n  border-radius: 34px;\n  text-align: center;\n  background: linear-gradient(135deg, #8c73f6 0%, #ff7b66 100%);\n  color: #ffffff;\n  box-shadow: 0 24px 60px rgba(140, 115, 246, 0.24);\n}\n\n.rr-final-cta h2 {\n  max-width: 820px;\n  margin: 0 auto 14px;\n  color: #ffffff;\n  font-size: clamp(34px, 4.4vw, 56px);\n  line-height: 1.05;\n  font-weight: 900;\n  letter-spacing: -0.055em;\n}\n\n.rr-final-cta p {\n  max-width: 720px;\n  margin: 0 auto;\n  color: #ffffff;\n  font-size: 17px;\n  line-height: 1.75;\n}\n\n.rr-final-buttons {\n  justify-content: center;\n}\n\n.rr-final-main {\n  background: #ffffff;\n  color: var(--rr-purple-dark) !important;\n}\n\n.rr-final-light {\n  background: rgba(255,255,255,0.16);\n  color: #ffffff !important;\n  border: 1px solid rgba(255,255,255,0.55);\n}\n\n/* RESPONSIVE */\n@media (max-width: 1100px) {\n  .rr-category-grid,\n  .rr-product-grid,\n  .rr-info-block {\n    grid-template-columns: 1fr;\n  }\n\n  .rr-advice-grid,\n  .rr-benefits {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 749px) {\n  .rr-home-wrap {\n    padding: 38px 14px;\n  }\n\n  .rr-section {\n    margin-bottom: 52px;\n  }\n\n  .rr-header-row {\n    display: block;\n  }\n\n  .rr-text-link {\n    display: inline-flex;\n    margin-top: 14px;\n  }\n\n  .rr-section-header h2,\n  .rr-info-content h2,\n  .rr-final-cta h2 {\n    font-size: 34px;\n    line-height: 1.1;\n  }\n\n  .rr-section-header p,\n  .rr-info-content p,\n  .rr-final-cta p {\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .rr-category-card {\n    min-height: auto;\n    border-radius: 24px;\n  }\n\n  .rr-category-photo {\n    height: 210px;\n  }\n\n  .rr-category-card h3 {\n    font-size: 26px;\n  }\n\n  .rr-advice-grid,\n  .rr-benefits {\n    grid-template-columns: 1fr;\n  }\n\n  .rr-product-image {\n    height: 225px;\n  }\n\n  .rr-product-image-photo img {\n    padding: 18px;\n  }\n\n  .rr-info-block {\n    padding: 24px 18px;\n    border-radius: 26px;\n  }\n\n  .rr-info-buttons,\n  .rr-final-buttons {\n    flex-direction: column;\n  }\n\n  .rr-main-btn,\n  .rr-light-btn,\n  .rr-final-main,\n  .rr-final-light {\n    width: 100%;\n  }\n\n  .rr-final-cta {\n    padding: 38px 20px;\n    border-radius: 28px;\n  }\n}\n</style>",
